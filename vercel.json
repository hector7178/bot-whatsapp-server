{
    "devCommand": "npm start",
    
    "buildCommand": "npm install pm2@latest -g && pm2 start  ecosystem.config.js ",
      
    "builds":[
        {
            "src":"index.js",
            "use":"@vercel/node"
           
        }
    ],
    "routes": [
        {
         
          "src": "/(.*)",
          "dest": "index.js"
        },
        {
         
            "src": "/chatlist/(.*)",
            "dest": "index.js"
        },
        {
         
            "src": "/sendmessage/(.*)",
            "dest": "index.js"
        },
        {
         
            "src": "/actualizar/respuestas",
            "dest": "index.js"
        }
        

    ]
  
      
}