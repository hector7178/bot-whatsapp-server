{
    "devCommand": "npm start",
    
    "buildCommand": "npm i pm2 -g && pm2 start node ecosystem.config.js",
      
    "builds":[
        {
            "src":"index.js",
            "use":"@vercel/node"
           
        }
    ],
    "routes": [
        {
         
          "src": "/(.*)",
          "dest": "index.js"
        },
        {
         
            "src": "/scan/(.*)",
            "dest": "index.js"
        },
        {
         
            "src": "/chatlist/(.*)",
            "dest": "index.js"
        },
        {
         
            "src": "/sendmessage/(.*)",
            "dest": "index.js"
        },
        {
         
            "src": "/actualizar/respuestas",
            "dest": "index.js"
        }
        

    ],
    "functions": {
        "/actualizar/respuestas": {
          "memory": 3008,
          "maxDuration": 10
        },
        "/sendmessage/(.*)": {
          "memory": 3008,
          "maxDuration": 10
        },
        "/chatlist/(.*)": {
            "memory": 3008,
            "maxDuration": 10
        },
        "/scan/(.*)": {
            "memory": 3008,
            "maxDuration": 10
        }
     
      }
  
      
}